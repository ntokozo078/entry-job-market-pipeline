# Copy this file to .env and fill in your own values. Never commit .env.

# Free keys from https://developer.adzuna.com/. Without them the pipeline skips Adzuna.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Any long random value. The app won't start on Render or with FLASK_ENV=production if this is unset.
SECRET_KEY=change-me-to-a-long-random-value

# Needed only to start a run through POST /refresh. Leave it empty to keep that endpoint closed.
REFRESH_TOKEN=

# Optional. Leave it commented out to use a local SQLite database.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
